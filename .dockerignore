# Don't ship dev artifacts to the image
.venv/
.git/
.pytest_cache/
.cursor/
.vscode/
.idea/
.DS_Store
__pycache__/
*.pyc

# Don't ship secrets
.env
.env.*

# Don't ship local data the deployed app doesn't need
data/state_b_claims.json
data/ground_truth.json
data/results/
# Note: these data files ARE shipped — needed by readers for demo:
#   - data/state_a_legacy.dat (read by legacy_reader for EBCDIC source)
#   - data/state_a_claims.json (read by local_lookup for State A quasi-identifiers)

# Don't ship eval infrastructure (the deployed app doesn't run evals)
evals/

# Don't ship docs
docs/
*.md
!README.md
!SCOPE.md